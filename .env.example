# Network
CORROBORA_HOST=127.0.0.1
CORROBORA_PORT=8000
CORROBORA_CORS_ORIGINS=localhost

# Storage
CORROBORA_DATA_DIR=./data
CORROBORA_CASES_DIR=./cases

# Investigation limits
CORROBORA_MAX_UPLOAD_MB=500
# CORROBORA_MAX_INGEST_MB=12288
CORROBORA_MAX_AGGREGATE_UPLOAD_MB=500
CORROBORA_MAX_CONCURRENT_JOBS=2
CORROBORA_MAX_QUEUED_JOBS=8
CORROBORA_INVESTIGATION_TIMEOUT_SECONDS=1800
CORROBORA_DETECTOR_TIMEOUT_SECONDS=30
CORROBORA_DETECTOR_EXECUTOR=process
CORROBORA_QUEUE_SYNC_INTERVAL_SECONDS=30

# Session policy
CORROBORA_SESSION_TTL_HOURS=12
CORROBORA_SESSION_IDLE_HOURS=2
CORROBORA_SECURE_COOKIES=0

# Optional runtime markers
CORROBORA_RUNTIME_MODE=local

# Optional demo redaction for public screenshots and demos
# CORROBORA_DEMO_REDACTION=1
# CORROBORA_DEMO_REDACTION_VALUES=demo-host,demo-user

# Optional hardening
# CORROBORA_CSRF_SECRET=replace-with-long-random-string
# Required before exposing a fresh install on a network: the first-admin
# screen then asks for this value, so nobody else can claim the instance.
# CORROBORA_BOOTSTRAP_TOKEN=replace-with-long-random-string
# Reverse-proxy addresses whose X-Forwarded-For header is trusted. Leave unset
# when clients connect directly; otherwise the header is ignored.
# CORROBORA_TRUSTED_PROXIES=127.0.0.1
# Required for network-bound local-path investigations; use one or more
# absolute evidence roots separated by the platform path separator.
# CORROBORA_ALLOWED_PATH_ROOTS=C:\\Evidence

# Days a new case is kept before it may be purged (1-3650)
# CORROBORA_CASE_RETENTION_DAYS=90


# LOCAL_COPILOT_LOG_LEVEL=info
