# Network
TRIAGE_HOST=127.0.0.1
TRIAGE_PORT=8000
TRIAGE_CORS_ORIGINS=localhost

# Storage
TRIAGE_DATA_DIR=./data
TRIAGE_CASES_DIR=./cases

# Investigation limits
TRIAGE_MAX_UPLOAD_MB=500
TRIAGE_MAX_AGGREGATE_UPLOAD_MB=500
TRIAGE_MAX_CONCURRENT_JOBS=2
TRIAGE_MAX_QUEUED_JOBS=8
TRIAGE_INVESTIGATION_TIMEOUT_SECONDS=1800
TRIAGE_DETECTOR_TIMEOUT_SECONDS=30
TRIAGE_DETECTOR_EXECUTOR=process
TRIAGE_QUEUE_SYNC_INTERVAL_SECONDS=30

# Session policy
TRIAGE_SESSION_TTL_HOURS=12
TRIAGE_SESSION_IDLE_HOURS=2
TRIAGE_SECURE_COOKIES=0

# Optional runtime markers
TRIAGE_RUNTIME_MODE=local

# Optional demo redaction for public screenshots and demos
# TRIAGE_DEMO_REDACTION=1
# TRIAGE_DEMO_REDACTION_VALUES=demo-host,demo-user

# Optional hardening
# TRIAGE_CSRF_SECRET=replace-with-long-random-string
# Required before exposing a fresh install on a network: the first-admin
# screen then asks for this value, so nobody else can claim the instance.
# TRIAGE_BOOTSTRAP_TOKEN=replace-with-long-random-string
# Reverse-proxy addresses whose X-Forwarded-For header is trusted. Leave unset
# when clients connect directly; otherwise the header is ignored.
# TRIAGE_TRUSTED_PROXIES=127.0.0.1
# Required for network-bound local-path investigations; use one or more
# absolute evidence roots separated by the platform path separator.
# TRIAGE_ALLOWED_PATH_ROOTS=C:\\Evidence

# Days a new case is kept before it may be purged (1-3650)
# TRIAGE_CASE_RETENTION_DAYS=90


# LOCAL_COPILOT_LOG_LEVEL=info
